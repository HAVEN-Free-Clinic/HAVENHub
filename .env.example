# --- Database ---------------------------------------------------------------
# Local dev points at the compose postgres (host port 5434; 5433 is often taken by other local stacks).
DATABASE_URL=postgresql://haven:haven_dev@localhost:5434/havenhub
# Direct (unpooled) connection used by `prisma migrate` only -- its advisory lock
# needs a stable session, which a PgBouncer pooler (e.g. Neon's -pooler endpoint)
# cannot guarantee. On Neon, this is the connection string WITHOUT "-pooler" in the
# host (Neon's Vercel integration provisions it as DATABASE_URL_UNPOOLED). Locally
# with a non-pooled Postgres, set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://haven:haven_dev@localhost:5434/havenhub
# Used by `npm test` (vitest.setup.ts). Created by `npm run test:prepare`.
TEST_DATABASE_URL=postgresql://haven:haven_dev@localhost:5434/havenhub_test

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Must also be present AT BUILD TIME: next.config.ts derives the Server Action
# encryption key from it so action ids survive a deploy. Without it Next picks a
# random key per build, every action id changes, and any tab still open from the
# previous deploy fails with UnrecognizedActionError. See
# src/platform/server-actions-key.ts.
AUTH_SECRET=change-me
# Optional explicit override for the above. Set this only if you need a Server
# Action key independent of AUTH_SECRET (e.g. rotating auth without invalidating
# every open tab). Must be a base64-encoded 32-byte key:
#   openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Microsoft Entra ID app registration (Yale tenant).
# OPTIONAL in development (dev credentials login works without them),
# REQUIRED in production. Boot fails loudly if missing.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Public URLs ---------------------------------------------------------------
# Public base URL of the hub, used in links inside outbound email (onboarding
# contract links, etc.) and as the metadataBase for Open Graph tags. MUST include
# the scheme (https://...) -- a scheme-less value is rejected at boot. Overridable
# per environment via the admin app.baseUrl setting. Defaults to localhost:3000.
APP_BASE_URL=http://localhost:3000

# Custom subdomain for the public application portal. When set, the portal is
# served from this origin (e.g. https://apply.havenfreeclinic.org/<slug>) via a
# host rewrite in src/proxy.ts, and shareable public links use it. Leave unset to
# keep the portal at <app>/apply. Deploy-time value; never from the request Host.
# Also add the Entra redirect URI <PORTAL_BASE_URL>/api/auth/callback/microsoft-entra-id
# in Azure, and confirm AUTH_URL / NEXTAUTH_URL is NOT pinned (rely on trustHost).
PORTAL_BASE_URL=

# GitBook docs visitor authentication + in-app Help widget. When BOTH are set, the docs
# redirect flow (/api/gitbook/auth) and the in-app Help launcher are enabled; when either is
# unset the endpoints respond 503 and the Help button does not render.
#   GITBOOK_JWT_KEY  -- per-site signing key from GitBook (Site > Audience > Custom).
#   GITBOOK_SITE_URL -- the PUBLISHED site URL, matching exactly the site the embed serves
#                       (e.g. https://docs.havenfreeclinic.org).
GITBOOK_JWT_KEY=
GITBOOK_SITE_URL=

# --- Airtable ----------------------------------------------------------------
# Personal access token for the read-only importer (scripts/import-*.ts).
# Scope: data.records:read on HAVEN Management.
AIRTABLE_PAT=
# Read sources (defaults are the real HAVEN Management base; IDs are not secrets).
HAVEN_MGMT_BASE_ID=appkxTQ19GmaHgW1O
ALL_PEOPLE_TABLE_ID=tblnHgBpknuqWvx9c
SU26_ROSTER_TABLE_ID=tbl2VrP1uqwFt7QNQ
# Spring 2026 roster, imported once as an ARCHIVED historical term
# (scripts/import-historical-term.ts).
SP26_ROSTER_TABLE_ID=tblv6XWgQNJ46cf6N

# --- Uploads -----------------------------------------------------------------
# Directory where uploaded HIPAA certificates are stored on disk.
# In production (SpinUp) this should be a mounted persistent volume.
UPLOAD_DIR=./uploads
# Maximum allowed upload size in megabytes (must be a positive integer).
# Defaults to 4, and anything larger is CLAMPED to 4: every upload except a SCORM
# package goes through a Server Action, and the platform rejects a request body
# over ~4.5 MB before any app code runs, so a bigger number only produces an
# opaque failure at the edge (#75). This line used to read 5, sized against
# Airtable's attachment cap, which stopped being relevant when the Airtable
# mirror was removed.
MAX_UPLOAD_MB=4

# Cloudflare R2 object storage. Set all four together or none at all; a partial
# configuration is rejected at boot. Leave unset for local development, where
# uploads go to UPLOAD_DIR on disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email transport. "log" (default) prints to stdout; "graph" sends via Microsoft
# Graph using the delegated OAuth flow (an admin connects a mailbox in Admin > Email);
# "maileroo" sends via the Maileroo HTTP API from our own verified domain.
#
# Graph sends as a Yale shared mailbox and inherits Exchange Online's ~30
# messages/minute submission cap, so a roster-wide campaign paces out over hours.
# Maileroo has no comparable per-minute ceiling, but its mail arrives at yale.edu
# as EXTERNAL mail (full spam filtering) rather than intra-tenant.
# Teams notifications always use Graph regardless of this setting.
EMAIL_TRANSPORT=log
# The mailbox to send AS (a shared mailbox the connecting admin can send from).
# Under "maileroo" this is the From address instead, and its domain must be
# verified in the Maileroo dashboard.
EMAIL_SENDER=hfc.it@yale.edu
# Maileroo sending key (Settings > API keys in the Maileroo dashboard), sent as
# the X-API-Key header. Required when EMAIL_TRANSPORT=maileroo. Sending keys are
# domain-scoped: a key issued for one domain answers 400 "not associated with
# this sending key" for every other one.
MAILEROO_API_KEY=
# Verified-domain allowlist: which transport can DKIM-sign for which From domain,
# as comma-separated "<domain>:<transport>" pairs. Optional. Leave unset to use
# the shipped default, which lives in src/platform/email/sending-domains.ts and
# carries the evidence for each domain. As of 2026-09-02, when Maileroo verified
# yale.edu, that default is:
#   havenfreeclinic.org:maileroo,yale.edu:maileroo
# A message whose From is on a listed domain goes out through that transport AS
# ITSELF; anything else falls back to the email.sender SETTING with the intended
# address kept as Reply-To. That setting is what pins the From, not this file:
# EMAIL_SENDER above is only its default, and an admin-set value in /admin/settings
# wins over it. Set SENDING_DOMAINS to reflect a Maileroo dashboard change without
# a code edit. The one to know is the REVERSAL: if Maileroo disables a domain
# again, "yale.edu:graph" puts it back on the delegated hfc.it@yale.edu mailbox
# through Microsoft Graph. It still needs a fresh process to take effect, so on
# Vercel that means a redeploy: what the override buys is an operator action
# instead of a pull request.
#
# An override REPLACES the default table rather than merging into it. A domain
# listed twice takes its LAST verdict. A malformed pair refuses to boot rather
# than silently narrowing the allowlist; an empty segment (a trailing comma) is
# fine, but a value that is ALL empty segments (",") refuses to boot too, because
# an empty allowlist would silently pin every send.
#
# Emergency lever: SENDING_DOMAINS=havenfreeclinic.org:maileroo drops yale.edu
# off the allowlist entirely, which sends every Yale identity through Maileroo
# pinned to the email.sender setting with the intended address demoted to
# Reply-To, exactly as it behaved before per-domain routing existed. Reach for
# the "yale.edu:graph" reversal above instead when Graph is available: it keeps
# the identity on the message.
SENDING_DOMAINS=
# "HAVEN Hub Mailer" Entra app registration (delegated Mail.Send + Mail.Send.Shared
# + offline_access + Channel.ReadBasic.All). Channel.ReadBasic.All (used for the
# clinic Teams channel link) requires tenant admin consent; the Mail scopes do not.
# Required when EMAIL_TRANSPORT=graph.
GRAPH_OAUTH_TENANT_ID=
GRAPH_OAUTH_CLIENT_ID=
GRAPH_OAUTH_CLIENT_SECRET=
GRAPH_OAUTH_REDIRECT_URI=http://localhost:3000/admin/email/oauth/callback
# Microsoft Teams clinic Team groupId (the Team that holds one channel per clinic
# week, each named "MM-DD-YY Clinic"). When set, the home dashboard links to the
# current week's channel. Requires the Mailer OAuth to be re-consented with the
# Channel.ReadBasic.All scope, and the connected mailbox to be a member of the Team.
TEAMS_CLINIC_GROUP_ID=
# Teams direct-message notifications reuse the Graph OAuth credentials above and
# the connected mailbox. After deploying, an admin must RECONNECT the mailbox in
# /admin/email once to grant the added Chat.Create + ChatMessage.Send scopes.
# Per-type routing (Email / Teams / Both) is configured in /admin/settings.

# --- Background cron ---------------------------------------------------------
# Shared secret the cron routes (src/app/api/cron/*) require. authorizeCron fails
# closed: with this unset, EVERY cron request is rejected (401) and no background
# job runs. Generate with: openssl rand -base64 32
# The per-minute email tick and the daily reminders job are triggered by
# an external scheduler (cron-job.org), which must send `Authorization: Bearer
# <CRON_SECRET>`. See docs/cron-jobs.md for the full job manifest and how to
# (re)provision the external schedules.
CRON_SECRET=

# --- PostHog (analytics, session replay, logs) -------------------------------
# Project token (starts with phc_) and ingest host. Used by posthog-js (browser),
# posthog-node (server events), and the OpenTelemetry log exporter in
# src/instrumentation.ts that ships server logs to PostHog Logs. Public values,
# not secrets. US cloud host is https://us.i.posthog.com (EU:
# https://eu.i.posthog.com). Server logs are only shipped when the token is set.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Intercom (support Messenger) --------------------------------------------
# In-hub support chat, mounted on authenticated (app) routes only. BOTH values
# are required to turn it on: an app id alone would boot an *unverified*
# Messenger, where identity is whatever the browser claims, so a member could
# impersonate another in support. UNSET (either one) = the feature is off and no
# third-party script loads, which is what dev, CI, and the e2e suite want.
#
# The app id identifies the workspace, not the user, and ships in the browser
# bundle -- public by design. The Messenger secret signs per-user JWTs
# (Settings > Workspace > Security > Messenger) and must never be exposed to the
# client, so it is deliberately not a NEXT_PUBLIC_ var. Rotate it there if leaked.
NEXT_PUBLIC_INTERCOM_APP_ID=
INTERCOM_MESSENGER_SECRET=

#
# The two below additionally enable the Fin MCP server (/api/mcp). Both must be
# set on top of the pair above, or the endpoint 404s. INTERCOM_ACCESS_TOKEN is a
# workspace access token used server-side to confirm a claimed Person id really
# belongs to the contact in the conversation; without that check the server would
# be trusting an identity the AI asserted. INTERCOM_MCP_BEARER_TOKEN is the shared
# secret Fin presents when calling us -- generate a long random value.
INTERCOM_ACCESS_TOKEN=
INTERCOM_MCP_BEARER_TOKEN=

# Enables the outbound half of the sync: a HAVEN Hub TechRequest status change
# posted into the member's linked Intercom conversation. Intercom requires an
# admin_id on every customer-visible reply, so this must be a real admin in
# the workspace -- a dedicated bot/workflow admin, not a rotating staff
# member's id. UNSET = status changes stay Hub- and email-only, same as today.
INTERCOM_BOT_ADMIN_ID=

# Enables the inbound ticket-sync webhook receiver (/api/support/tickets/events):
# Intercom's ticket.created and ticket.state.updated events open and update
# TechRequest rows. This is the app's CLIENT SECRET (Settings > Basic Info),
# NOT INTERCOM_ACCESS_TOKEN above -- a different credential Intercom uses to
# sign each webhook's raw body (HMAC-SHA1, X-Hub-Signature header), so the
# receiver can verify a request actually came from Intercom before touching
# the database. UNSET = the endpoint 404s, same posture as the rest of this
# file; also requires INTERCOM_ACCESS_TOKEN, since ticket.created resolves
# identity and writes the ticket number back through that same token.
INTERCOM_WEBHOOK_SECRET=

# --- Wallet badges (walletwallet.dev) ----------------------------------------
# Apple/Google Wallet volunteer badges. The vendor signs with ITS certificate,
# so HAVEN needs no Apple Developer membership and no Google issuer account.
# UNSET = the whole feature is off: no HTTP call is attempted and the wallet
# section does not render on /my-info. Set it only once the badge is wanted.
WALLETWALLET_API_KEY=

# Pro tier ("true"/"false", default false). Pro is what makes the brand colour
# and the logo/icon images take effect; the free tier honours only colorPreset.
# Deliberately a SEPARATE switch from the key, because the clinic is on a
# time-limited trial: when it lapses, set this false and branded fields stop
# being sent, with the card falling back to the preset. No code change, and no
# branded fields sent to an account that would ignore them.
WALLETWALLET_PRO=false
