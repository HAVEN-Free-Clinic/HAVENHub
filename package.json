{
  "name": "havenhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "//dev": "Pins the local database explicitly. .env carries the production Neon URL for the deploy scripts, and Next does not override variables already in the environment, so naming it here is what keeps `npm run dev` off production. Use dev:remote to opt in deliberately.",
    "dev": "DATABASE_URL=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} DATABASE_URL_UNPOOLED=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} next dev",
    "dev:remote": "ALLOW_REMOTE_DEV_DB=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "//test:related": "Tests that import the given files, directly or transitively. The fast inner loop: about 25s for a typical service file against ~170s for the whole suite.",
    "test:related": "vitest related --run",
    "test:changed": "vitest run --changed origin/main",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test:prepare": "docker compose exec -T postgres psql -U haven -d havenhub -c \"CREATE DATABASE havenhub_test\" || true && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub_test} DATABASE_URL_UNPOOLED=${TEST_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub_test} npx prisma migrate deploy",
    "postinstall": "prisma generate",
    "prepare": "git config core.hooksPath .githooks || true",
    "db:up": "docker compose up -d postgres",
    "db:wait": "until docker compose exec -T postgres pg_isready -U haven >/dev/null 2>&1; do sleep 1; done",
    "//db:setup": "One command from a fresh clone to a working local database: container up, schema applied, dev fixtures seeded, and the test template prepared.",
    "db:setup": "npm run db:up && npm run db:wait && npm run db:deploy && npm run db:seed && npm run test:prepare",
    "//db:migrate": "The db:* scripts name the local database for the same reason dev does. Migrating or seeding whatever .env happens to point at is how a dev command reaches production.",
    "db:migrate": "DATABASE_URL=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} DATABASE_URL_UNPOOLED=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} prisma migrate dev",
    "db:deploy": "DATABASE_URL=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} DATABASE_URL_UNPOOLED=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} prisma migrate deploy",
    "db:seed": "DATABASE_URL=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} DATABASE_URL_UNPOOLED=${DEV_DATABASE_URL:-postgresql://haven:haven_dev@localhost:5434/havenhub} prisma db seed",
    "e2e": "playwright test",
    "import:dry": "tsx --env-file=.env scripts/import-airtable.ts",
    "import:apply": "tsx --env-file=.env scripts/import-airtable.ts --apply",
    "import:certs:dry": "tsx --env-file=.env scripts/import-certificates.ts",
    "import:certs:apply": "tsx --env-file=.env scripts/import-certificates.ts --apply",
    "backfill:dates:dry": "tsx --env-file=.env scripts/backfill-completion-dates.ts",
    "backfill:dates:apply": "tsx --env-file=.env scripts/backfill-completion-dates.ts --apply",
    "backfill:languages:dry": "tsx --env-file=.env scripts/backfill-language-question.ts",
    "backfill:languages:apply": "tsx --env-file=.env scripts/backfill-language-question.ts --apply",
    "backfill:langbadges:dry": "tsx --env-file=.env scripts/backfill-language-badges.ts",
    "backfill:langbadges:apply": "tsx --env-file=.env scripts/backfill-language-badges.ts --apply",
    "backfill:nonyale:dry": "tsx --env-file=.env scripts/backfill-non-yale-identity.ts",
    "backfill:nonyale:apply": "tsx --env-file=.env scripts/backfill-non-yale-identity.ts --apply",
    "//intercom:recover": "Recovers an Intercom Ticket the Hub has no row for (a refused or pre-webhook ticket.created). Needs .env.local too, for INTERCOM_ACCESS_TOKEN. Pass the ticket id after --.",
    "intercom:recover:dry": "tsx --env-file=.env --env-file=.env.local scripts/recover-intercom-ticket.ts",
    "intercom:recover:apply": "tsx --env-file=.env --env-file=.env.local scripts/recover-intercom-ticket.ts --apply",
    "import:schedule:dry": "tsx --env-file=.env scripts/import-schedule.ts",
    "import:schedule:apply": "tsx --env-file=.env scripts/import-schedule.ts --apply",
    "import:config:dry": "tsx --env-file=.env scripts/import-schedule-config.ts",
    "import:config:apply": "tsx --env-file=.env scripts/import-schedule-config.ts --apply",
    "import:rhd:dry": "tsx --env-file=.env scripts/import-rhd.ts",
    "import:rhd:apply": "tsx --env-file=.env scripts/import-rhd.ts --apply",
    "import:histterm:dry": "tsx --env-file=.env scripts/import-historical-term.ts",
    "import:histterm:apply": "tsx --env-file=.env scripts/import-historical-term.ts --apply",
    "import:history:dry": "tsx --env-file=.env scripts/import-history.ts",
    "import:history:apply": "tsx --env-file=.env scripts/import-history.ts --apply",
    "fixtures:ux": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-ux-audit-fixtures.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@bprogress/next": "^3.2.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gitbook/embed": "^0.5.1",
    "@intercom/messenger-js-sdk": "^0.0.20",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@posthog/nextjs-config": "^1.9.68",
    "@prisma/client": "^6.19.2",
    "@react-pdf/renderer": "^4.5.1",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "cron-parser": "^5.5.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.8",
    "juice": "^11.1.1",
    "lucide-react": "^0.487.0",
    "mcp-handler": "^2.1.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.402.2",
    "posthog-node": "^5.43.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "scorm-again": "^3.0.5",
    "sharp": "^0.35.3",
    "signature_pad": "^5.1.3",
    "unpdf": "^1.6.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "xlsx": "^0.18.5"
  }
}
