model Application {
  id                         String            @id @default(cuid())
  cycleId                    String
  applicantId                String
  answers                    Json
  applicantType              ApplicantType     @default(NEW)
  departmentChoices          String[]
  renewalDepartment          String?
  // For a TRANSFER applicant: a snapshot of the department codes they were an
  // active member of at submit time (where they are coming from). Empty for
  // NEW and RENEWAL.
  transferFromDepartments    String[]          @default([])
  // ordered subcommittee IDs the applicant ranked (1st -> Nth); hoisted from the
  // SUBCOMMITTEE_RANK field answer at submit, like departmentChoices.
  subcommitteeRanking        String[]
  /// Language CODES the applicant said they speak, hoisted at submit from the
  /// standard languages question (see LANGUAGES_FIELD_KEY). Hoisted rather than
  /// left in `answers` so promotion can turn them into PersonLanguage claims
  /// without re-parsing a JSON blob whose field key a cycle could have changed.
  languagesClaimed           String[]
  assignedSubcommitteeId     String?
  assignedSubcommitteeById   String?
  assignedSubcommitteeAt     DateTime?
  routedDepartmentCode       String?
  routedById                 String?
  routedAt                   DateTime?
  // Second-choice discretion. A department that decides an applicant is not a fit
  // for THEM, rather than not a fit for the clinic, returns the application to the
  // recruitment lead instead of rejecting it. The three fields below are set
  // together and cleared together by routeApplication, so a non-null
  // returnedToRoutingAt is the single marker for "awaiting re-routing".
  //
  // routedDepartmentCode is cleared on return (the declining department must drop
  // out of their own review queue), so the department that declined is recorded
  // here instead. Only the MOST RECENT return is kept; the full decline history
  // lives in the audit log under recruitment.return_to_routing.
  returnedToRoutingAt        DateTime?
  returnedFromDepartmentCode String?
  returnedById               String?
  returnedReason             String?
  // The routed department's decision on a VOLUNTEER application (no interview).
  // Director-track decisions live on Interview.decision instead.
  decision                   InterviewDecision @default(PENDING)
  decidedById                String?
  decidedAt                  DateTime?
  decisionNotes              String?
  status                     ApplicationStatus @default(SUBMITTED)
  /// Set when the applicant removed themselves through the portal. Null on every
  /// other row. Withdrawal is a declaration only: it never deletes acceptances,
  /// interviews, or onboarding contracts, which have their own guarded teardown.
  withdrawnAt                DateTime?
  submittedAt                DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  cycle                  RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  applicant              Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  acceptances            Acceptance[]
  interviews             Interview[]
  committeeScores        CommitteeScore[]
  assignedSubcommittee   Subcommittee?    @relation("applicationAssignedSubcommittee", fields: [assignedSubcommitteeId], references: [id], onDelete: SetNull)
  assignedSubcommitteeBy Person?          @relation("applicationSubcommitteeAssigner", fields: [assignedSubcommitteeById], references: [id], onDelete: SetNull)
  routedBy               Person?          @relation("applicationRoutedBy", fields: [routedById], references: [id], onDelete: SetNull)
  returnedBy             Person?          @relation("applicationReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  decidedBy              Person?          @relation("applicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([cycleId, applicantId])
  @@index([cycleId, submittedAt])
}

