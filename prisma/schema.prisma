  dietaryRestrictions      String?
  yaleAffiliation          String?
  pronouns                 String?
  staffTitle               String?
  epicIdExpiration         DateTime?
  gradYear                 String?
  agreementSignature       String?
  professionalismSignature String?
  trainingSignature        String?
  initials                 String?
  epicNeeded               Boolean        @default(false)
  hasEpic                  Boolean        @default(false)
  existingEpicId           String?
  epicAccessType           String?
  worksWithYnhh            Boolean        @default(false)
  spanishSelfReported      Boolean        @default(false)
  licensedRN               Boolean        @default(false)
  hipaaStoredName          String?
  hipaaFileName            String?
  hipaaMimeType            String?
  hipaaSize                Int?
  hipaaCompletedAt         DateTime?
  sentAt                   DateTime?
  /// When the onboarding link stops being usable. Set (and refreshed) on every
  /// send/resend. Null on contracts created before this field existed: those are
  /// grandfathered (no expiry) until the next resend stamps one.
  expiresAt                DateTime?
  submittedAt              DateTime?
  promotedAt               DateTime?
  promotedById             String?
  promotedPersonId         String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  templateSnapshot         Json?
  customAnswers            Json?
  signatures               Json?
  /// The visibility context (department/track/epicRequirement/storedEpicId) frozen
