}

/// Flags a person for offboarding at the end of a given term. At most one flag
/// per (person, term) pair. Cascade-deleted when the person or term is removed
/// (flags are transient workflow state with no independent archival value).
model OffboardFlag {
  id          String   @id @default(cuid())
  personId    String
  termId      String
  flaggedById String
  note        String?
  createdAt   DateTime @default(now())
  /// Subject of the flag. Cascade: if the person is deleted the flag is meaningless.
  person      Person   @relation("offboardFlagPerson", fields: [personId], references: [id], onDelete: Cascade)
  /// Term in which the person should be offboarded. Cascade: if the term is deleted the flag is meaningless.
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  /// Person who raised the flag. Restrict: flags are workflow state the offboarding executor acts on; deleting a person who flagged others must not silently empty the queue.
  flaggedBy   Person   @relation("offboardFlagFlaggedBy", fields: [flaggedById], references: [id], onDelete: Restrict)

  @@unique([personId, termId])
}

/// A request to create, modify, or renew a person's EPIC EMR access. Linked
/// optionally to a YnhhTicket once one is opened with YNHH IT. Cascade-deleted
/// with the person (the person is the subject of the request).
model EpicRequest {
  id            String            @id @default(cuid())
  personId      String
  kind          EpicRequestKind
  status        EpicRequestStatus @default(PENDING)
  jobTitle      String?
  mirrorEpicId  String?
  notes         String?
  requestedById String
  ticketId      String?
  techRequestId String?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  /// Subject of the request. Cascade: requests belong to the person.
  person        Person            @relation("epicRequestPerson", fields: [personId], references: [id], onDelete: Cascade)
  /// Person who submitted the request. Restrict: any referencing row blocks deletion of this person.
  requestedBy   Person            @relation("epicRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  /// The YNHH ticket opened for this request (optional).
  ticket        YnhhTicket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// The IT Support ticket this request is attached to, if any. SetNull: deleting the ticket detaches its requests but keeps them for YNHH/audit history.
  techRequest   TechRequest?      @relation("techRequestEpic", fields: [techRequestId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([personId, status])
  @@index([techRequestId])
}

/// A service request ticket opened with YNHH IT, grouping one or more EPIC
/// access requests. Rows are kept for audit purposes even after the ticket closes.
model YnhhTicket {
  id                   String                  @id @default(cuid())
  serviceRequestNumber String?
  /// Airtable "YNHH Ticket Tracker" record this ticket was imported from.
  /// Null for tickets opened natively in the hub. See
  /// scripts/import-support-history.ts.
  airtableRecordId     String?                 @unique
  description          String?
  /// One-off incident subject. Set for standalone YNHH incidents logged directly (not Epic batches).
  subject              String?
  /// Resolution notes captured when a one-off incident is resolved.
  resolution           String?
  status               YnhhTicketStatus        @default(OPEN)
  submittedById        String
  personId             String?
  submittedAt          DateTime                @default(now())
  closedAt             DateTime?
  /// EPIC requests grouped under this ticket.
  requests             EpicRequest[]
  /// Person who submitted the ticket to YNHH IT. Restrict: any referencing row blocks deletion of this person.
  submittedBy          Person                  @relation("ynhhTicketSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  /// Optional person a one-off YNHH incident concerns. SetNull: keep the log entry if the person is deleted.
  person               Person?                 @relation("ynhhTicketPerson", fields: [personId], references: [id], onDelete: SetNull)
  /// Files attached to a one-off YNHH incident.
  attachments          TechRequestAttachment[]
}

enum TechRequestCategory {
  EPIC
  DUO_MFA
  GENERAL_IT
  TEAMS
  /// Problems with HAVEN Hub itself (bugs, access, feature requests), as opposed
  /// to the external systems the other categories cover. Added once Intercom
  /// became the support front door and Hub reports needed somewhere to land
  /// other than GENERAL_IT, where they were indistinguishable from Yale IT work.
  HAVEN_HUB
  OTHER
}

enum TechRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TechRequestStatus {
  SUBMITTED
  IN_PROGRESS
  AWAITING_REQUESTER
  AWAITING_YNHH
  RESOLVED
  CLOSED
  CANCELLED
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

/// An IT Support ticket. The umbrella over all tech requests; the EPIC category
/// links to an EpicRequest once a manager promotes it. Cascade-deleted with the
/// requester (the subject of the request).
model TechRequest {
  id                     String              @id @default(cuid())
  number                 Int                 @unique @default(autoincrement())
  /// Airtable "Tech Requests" record this ticket was imported from. Null for
  /// tickets submitted natively in the hub. See
  /// scripts/import-support-history.ts.
  airtableRecordId       String?             @unique
  requesterId            String
  category               TechRequestCategory
  epicSubtype            EpicRequestKind?
  subject                String
  description            String
  priority               TechRequestPriority @default(MEDIUM)
  status                 TechRequestStatus   @default(SUBMITTED)
  assignedToId           String?
  resolution             String?
  resolvedAt             DateTime?
  /// The Intercom conversation this ticket was opened from, when it came in through
  /// support chat rather than the Hub form. Unique: a conversation maps to at most one
  /// ticket, which is what makes the create path idempotent under Intercom retries.
  intercomConversationId String?             @unique
  /// The Intercom Ticket this record is linked to, a DIFFERENT Intercom object from
  /// intercomConversationId: the conversation resolves identity and receives internal
  /// notes, while the ticket carries state (Direction 3's inbound sync) and the "Hub
  /// ticket number" attribute (the write-back the conversation-only id could never
  /// reach). Unique: a ticket maps to at most one TechRequest, which is what makes
  /// ticket.created idempotent under Intercom's webhook retries. Collapsing these two
  /// ids into one field is the mistake the design doc records costing an afternoon.
  intercomTicketId       String?             @unique
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  /// Subject of the request. Cascade: tickets belong to the requester.
  requester    Person        @relation("techRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// Manager assigned to work the ticket. Restrict: an assigned person cannot be deleted out from under open work.
  assignedTo   Person?       @relation("techRequestAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  /// Epic access requests attached to this ticket (0..n). See EpicRequest.techRequestId.
  epicRequests EpicRequest[] @relation("techRequestEpic")

  comments    TechRequestComment[]
  attachments TechRequestAttachment[]

  @@index([status])
  @@index([requesterId])
  @@index([assignedToId])
}

/// A comment on a TechRequest. PUBLIC is visible to the requester and managers;
/// INTERNAL is manager-only. Cascade-deleted with the ticket.
model TechRequestComment {
  id         String            @id @default(cuid())
  requestId  String
  authorId   String
  body       String
  visibility CommentVisibility @default(PUBLIC)
  createdAt  DateTime          @default(now())

  request     TechRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Author of the comment. Restrict: keep authorship stable for audit.
  author      Person                  @relation("techRequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments TechRequestAttachment[]

  @@index([requestId])
}

/// A file attached to a ticket or a comment (exactly one of requestId/commentId).
/// storageKey is the key passed to putObject/getObject; bytes live in Blob.
model TechRequestAttachment {
  id           String   @id @default(cuid())
  requestId    String?
  commentId    String?
  ynhhTicketId String?
  storageKey   String
  filename     String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  request    TechRequest?        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  comment    TechRequestComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// One-off YNHH incident this file is attached to (manager-only download).
  ynhhTicket YnhhTicket?         @relation(fields: [ynhhTicketId], references: [id], onDelete: Cascade)
  /// Uploader. Restrict: keep provenance stable for audit.
  uploadedBy Person              @relation("techRequestUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([commentId])
  @@index([ynhhTicketId])
}

/// A formal disciplinary action recorded against a volunteer or director.
/// Cascade-deleted with the person (the subject); issuer uses Restrict so a
/// director cannot be deleted while they have issued actions.
model DisciplinaryAction {
  id              String          @id @default(cuid())
  personId        String
  issuedById      String
  occurredAt      DateTime
  category        String
  description     String
  followUpActions String?
  policyReference String?
  notes           String?
  confidential    Boolean         @default(false)
  patientInvolved Boolean         @default(false)
  createdAt       DateTime        @default(now())
  /// When this strike was issued by approving an incident report's strike request.
  reportId        String?
  report          IncidentReport? @relation("incidentReportStrikeAction", fields: [reportId], references: [id], onDelete: SetNull)
  /// Subject of the action. Cascade: records belong to the person.
  person          Person          @relation("disciplinaryActionPerson", fields: [personId], references: [id], onDelete: Cascade)
  /// Person who issued the action. Restrict: the issuer should not be deleted while records exist.
  issuedBy        Person          @relation("disciplinaryActionIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  forwards        IncidentForward[]

  @@unique([reportId, personId])
  @@index([personId])
}

/// A Professional Standards Incident Report. Any signed-in person may file one
/// about anyone; reviewers (incidents.manage) triage them. A director filing
/// about a volunteer they manage may request a strike, which a reviewer approves
/// (issuing a linked DisciplinaryAction) or declines.
model IncidentReport {
  id                    String                     @id @default(cuid())
  number                Int                        @unique @default(autoincrement())
  reporterId            String
  anonymous             Boolean                    @default(false)
  concernTypes          String[]                   @default([])
  description           String                     @db.Text
  occurredAt            DateTime?
  setting               String?
  subjectDescription    String?
  patientImpact         PatientImpact?
  patientImpactDetail   String?
  immediateRisk         Boolean                    @default(false)
  issueNature           IssueNature?
  priorOccurrence       PriorOccurrence?
  priorOccurrenceDetail String?
  /// Why the reporter asked to stay anonymous to the subject. Optional even when
  /// `anonymous` is set: this form is a safety-reporting path, so a required
  /// justification would add friction exactly where friction deters reporting.
  /// Reviewer-facing only, and never rendered to the subject -- anonymity drives
  /// a confidential strike (see decideStrike), and this text would often identify
  /// the reporter to anyone who knows the shift.
  anonymousReason       String?                    @db.Text
  status                IncidentReportStatus       @default(SUBMITTED)
  reviewNotes           String?                    @db.Text
  resolvedById          String?
  resolvedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  /// The person who filed the report. Restrict: the reporter is load-bearing for the record.
  reporter              Person                     @relation("incidentReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  /// The reviewer who resolved or dismissed the report.
  resolvedBy            Person?                    @relation("incidentReportResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  attachments           IncidentReportAttachment[]
  subjects              IncidentReportSubject[]
  strikeActions         DisciplinaryAction[]       @relation("incidentReportStrikeAction")
  forwards              IncidentForward[]
  messages              IncidentReportMessage[]

  @@index([status])
  @@index([reporterId])
}

/// One message in the clarification thread between a reviewer and the reporter
/// of an incident report: a reviewer asking for more detail, or the reporter
/// answering. Ordinary back-and-forth, deliberately NOT a general comment log --
/// reviewer-to-reviewer notes live in IncidentReport.reviewNotes, which the
/// reporter never sees.
///
/// Whether a row is a question or an answer is `authorId == report.reporterId`,
/// not a stored column: a column would be a second copy of a fact the report
/// already holds, free to drift away from it.
///
/// Confidentiality: readable only by the reporter and by holders of
/// incidents.manage who are NOT linked as a subject of the report -- the same
/// rule getReport enforces, re-derived in services/messages.ts rather than
/// assumed from the caller. A subject of the report never sees this thread, and
/// nothing here reaches the director-visible strike surface.
model IncidentReportMessage {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Author of the message. Restrict: keep authorship stable for audit, matching
  /// IncidentReport.reporter and TechRequestComment.author.
  author Person         @relation("incidentReportMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
}

/// Links an incident report to one person involved (one row per person) and
/// carries that person's per-report strike-request state, so a single report
/// can hold independent strike requests against multiple people.
model IncidentReportSubject {
  id                String          @id @default(cuid())
  reportId          String
  personId          String
  /// null = linked for context only. PENDING/APPROVED/DECLINED = strike request state.
  strikeDecision    StrikeDecision?
  strikeDecidedById String?
  strikeDecidedAt   DateTime?
  createdAt         DateTime        @default(now())
  /// Cascade: the link belongs to the report.
  report            IncidentReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Cascade: the link is meaningless without the person.
  person            Person          @relation("incidentReportSubjectPerson", fields: [personId], references: [id], onDelete: Cascade)
  /// The reviewer who decided this person's strike request.
  strikeDecidedBy   Person?         @relation("incidentReportSubjectStrikeDecidedBy", fields: [strikeDecidedById], references: [id], onDelete: SetNull)

  @@unique([reportId, personId])
  @@index([reportId])
  @@index([personId])
}

/// One disclosure of an incident report, or of an issued strike, to a clinical
/// supervisor OUTSIDE the Hub. Written every time a reviewer forwards, and
/// rendered back on the source record as a visible trail.
///
/// This exists because the disclosure leaves the organization and cannot be
/// walked back. EmailLog already records that a message was sent, but a reviewer
/// deciding whether to forward needs to see, on the report itself, who has
/// already received it -- and an after-the-fact audit needs it attached to the
/// record rather than reconstructed from mail logs.
///
/// Exactly one of reportId / actionId is set. DB-LEVEL GUARD LIVES IN RAW SQL
/// (see the migration): a CHECK constraint, following the RoleAssignment
/// precedent, because Prisma cannot express "exactly one of these".
model IncidentForward {
  id           String              @id @default(cuid())
  reportId     String?
  actionId     String?
  /// Address as sent. Stored rather than referenced: the settings directory is
  /// free text and an entry can be edited or removed after a forward, which must
  /// not rewrite or orphan the historical record of who actually received it.
  toEmail      String
  /// Display name at the time of sending, when the directory entry had one.
  toName       String?
  /// The reviewer's optional covering note, included in the email body.
  note         String?             @db.Text
  forwardedById String
  createdAt    DateTime            @default(now())
  /// Cascade: the trail belongs to the report.
  report       IncidentReport?     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Cascade: the trail belongs to the strike.
  action       DisciplinaryAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  /// Restrict: the forwarding reviewer is the accountable party on a disclosure
  /// that left the clinic, so the record must not lose them.
  forwardedBy  Person              @relation("incidentForwardForwardedBy", fields: [forwardedById], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([actionId])
}

/// A file attached to an incident report. Bytes live in storage under storedName
/// (src/platform/storage.ts putObject/getObject); this row is the metadata +
/// ownership record. Mirrors the HipaaCertificate storage-key convention.
model IncidentReportAttachment {
  id           String         @id @default(cuid())
  reportId     String
  fileName     String
  storedName   String
  size         Int
  mimeType     String
  uploadedById String
  createdAt    DateTime       @default(now())
  report       IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedBy   Person         @relation("incidentAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([reportId])
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  SENT
  CANCELLED
}

model EmailCampaign {
  id           String              @id @default(cuid())
  name         String
  recordType   String              @default("PERSON")
  audienceJson Json
  subject      String              @default("")
  body         String              @default("")
  status       EmailCampaignStatus @default(DRAFT)
  scheduleType String              @default("NOW") // NOW | SCHEDULED | RECURRING
  scheduledAt  DateTime?
  cronExpr     String?
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdById  String?
  createdBy    Person?             @relation("campaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  runs         EmailCampaignRun[]
}

model EmailCampaignRun {
  id             String        @id @default(cuid())
  campaignId     String
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  runAt          DateTime      @default(now())
  recipientCount Int           @default(0)
  emails         EmailLog[]    @relation("emailLogCampaignRun")

  @@index([campaignId])
}

/// Outbox for transactional emails. The drain worker reads QUEUED rows and
/// sends them via the mail provider. Unlike Outbox, the html body is stored
/// on the row so the drain needs no template knowledge. Both person references
/// are optional with SetNull so email history survives person deletion.
model EmailLog {
  id            String            @id @default(cuid())
  toEmail       String
  subject       String
  html          String
  template      String
  /// Snapshot of the resolved sender at enqueue time. Null means use the global default sender.
  fromEmail     String?
  /// Optional display name paired with fromEmail.
  fromName      String?
  /// Person the email was addressed to (optional; may be null for non-person recipients).
  personId      String?
  /// Person who triggered the email (e.g. the director who performed an action). SetNull on delete.
  triggeredById String?
  campaignRunId String?
  status        EmailStatus       @default(QUEUED)
  attempts      Int               @default(0)
  lastError     String?
  sentAt        DateTime?
  /// Set while a drain worker is sending this row so a concurrent drain skips it.
  /// Cleared on completion; a stale lock (crashed worker) is reclaimable after a timeout.
  lockedAt      DateTime?
  createdAt     DateTime          @default(now())
  /// SetNull: email logs outlive the people they reference.
  person        Person?           @relation("emailLogPerson", fields: [personId], references: [id], onDelete: SetNull)
  /// SetNull: email logs outlive the people they reference.
  triggeredBy   Person?           @relation("emailLogTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  campaignRun   EmailCampaignRun? @relation("emailLogCampaignRun", fields: [campaignRunId], references: [id], onDelete: SetNull)

  @@unique([campaignRunId, toEmail])
  @@index([personId])
  @@index([status, createdAt])
  /// The admin email monitor's DEFAULT listing: no filter, ORDER BY createdAt
  /// DESC, id DESC, LIMIT 50 (listEmails in src/modules/admin/services/email.ts).
  /// [status, createdAt] cannot serve it -- status is the leading column and the
  /// unfiltered case has no equality on it -- so every visit sequentially scanned
  /// and sorted the fastest-growing table in the app. Declared ascending because
  /// a btree scans backwards just as cheaply, and the id tiebreaker is part of
  /// the index so the ordering is fully satisfied without a sort node.
  /// (audit 14, DM-3.)
  @@index([createdAt, id])
  /// The "Sent today" tile: status = SENT AND sentAt >= start-of-day. sentAt is
  /// not in any other index, so this counted by scanning every SENT row ever.
  /// (audit 14, DM-3.)
  @@index([status, sentAt])
}

/// Admin override of a code-default email template, keyed by descriptor key (e.g. "layout", "compliance-reminder").
model EmailTemplate {
  id          String   @id @default(cuid())
  /// Descriptor key this row overrides. Unique: at most one override per template.
  key         String   @unique
  subject     String
  body        String
  updatedById String?
  updatedBy   Person?  @relation("emailTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EmailSenderScope {
  CATEGORY
  TEMPLATE
}

/// Per-scope sender override. A CATEGORY row targets all templates in a named group;
/// a TEMPLATE row targets a single descriptor key.
model EmailSenderRule {
  id          String           @id @default(cuid())
  scope       EmailSenderScope
  /// Group name when scope=CATEGORY; template descriptor key when scope=TEMPLATE.
  target      String
  fromEmail   String
  fromName    String?
  updatedById String?
  updatedBy   Person?          @relation("emailSenderRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([scope, target])
}

/// Per-cycle override of a recruitment email. A row exists only when a cycle
/// customizes that email; absence means inherit the global default. `key` is one
/// of the cycle-scoped recruitment descriptor keys (not recruitment.portal_link).
model RecruitmentCycleEmail {
  id          String           @id @default(cuid())
  cycleId     String
  cycle       RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  key         String
  subject     String
  body        String
  updatedById String?
  updatedBy   Person?          @relation("recruitmentCycleEmailUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([cycleId, key])
}

/// Per-person HIPAA reminder state. Drives the weekly cadence (lastRemindedAt),
/// the escalation threshold (remindersSent), and the once-only director
/// escalation (escalatedAt). Reset to zero when the person becomes COMPLIANT.
/// Per-person reminder state for the clearance engine. One row per person, with an
/// independent claim per leg: `lastRemindedAt` paces the HIPAA reminder, and
/// `onboardingLastRemindedAt` paces the onboarding-requirements reminder, which runs
/// on a much shorter interval. `stalledSince` is stamped on the first nag of a streak
/// and cleared when both legs are satisfied; the weekly director digest sorts and
/// flags on it. Mapped to the original table name so the rename cost no migration.
model MemberReminderState {
  id                       String    @id @default(cuid())
  personId                 String    @unique
  remindersSent            Int       @default(0)
  lastRemindedAt           DateTime?
  onboardingRemindersSent  Int       @default(0)
  onboardingLastRemindedAt DateTime?
  stalledSince             DateTime?
  person                   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("ComplianceReminder")
}

/// Idempotency marker for periodic reminder dispatches (shift reminders + schedule
/// request reminders, which have no per-person state table of their own). One row
/// per (kind, personId, periodKey); the unique index turns "insert the marker" into
/// an atomic claim, so two overlapping cron runs cannot both send the same reminder.
/// Rows are lightweight (one per person per period) and retained.
model ReminderDispatch {
  id        String   @id @default(cuid())
  kind      String
  personId  String
  periodKey String
  createdAt DateTime @default(now())

  @@unique([kind, personId, periodKey])
}

/// Single-row store for the delegated Graph mail credential (the rotating
/// refresh token and connection metadata). id defaults to a fixed sentinel so
/// there is at most one row.
model MailCredential {
  id           String   @id @default("mailer")
  refreshToken String
  account      String?
  scope        String?
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Outbound Teams 1:1 chat message queue (mirrors EmailLog). Drained by the
/// email cron alongside the email queue. Carries the email fallback payload so a
/// permanently-failed Teams send degrades to email without re-involving the caller.
model TeamsMessage {
  id                 String             @id @default(cuid())
  /// Recipient person. Teams messages are always person-addressed.
  personId           String
  /// Notification type key from the notification registry (e.g. "compliance-reminder").
  type               String
  title              String
  summary            String
  link               String?
  /// Rendered HTML body posted to the Teams chat.
  bodyHtml           String
  /// Cached 1:1 chat id once resolved, so a retry does not re-create the chat.
  chatId             String?
  /// Email fallback payload, queued if Teams delivery fails permanently.
  fallbackSubject    String
  fallbackHtml       String
  /// True when notify() already queued this email up front (channel "both"), so
  /// the permanent-failure fallback must skip it rather than double-send (#74).
  emailAlreadyQueued Boolean            @default(false)
  status             TeamsMessageStatus @default(QUEUED)
  attempts           Int                @default(0)
  lastError          String?
  sentAt             DateTime?
  /// Per-row send claim: set when a drain worker takes the row, cleared on
  /// completion. Lets overlapping drains avoid double-sending (mirrors EmailLog).
  lockedAt           DateTime?
  createdAt          DateTime           @default(now())
  /// Cascade: Teams messages do not outlive the person they address.
  person             Person             @relation("teamsMessagePerson", fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([status, createdAt])
}

/// Per-person in-app notification (the bell inbox). Written unconditionally by
/// notify() for every notification addressed to a person, independent of the
/// Email/Teams channel routing. readAt null means unread.
model Notification {
  id        String    @id @default(cuid())
  personId  String
  /// Notification registry key (e.g. "epic-activation").
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  /// Cascade: notifications do not outlive the person they address.
  person    Person    @relation("personNotifications", fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
  @@index([personId, readAt])
}

/// One row per person per clinic shift. Med-team tags apply to VOLUNTEER rows;
/// the legacy invariant holds: a triage/walk-in/CC/remote designee is also on
/// shift (their row IS the on-shift row, tags are attributes of it).
model ShiftAssignment {
  id           String     @id @default(cuid())
  termId       String
  departmentId String
  personId     String
  /// Calendar date, anchored at 12:00 UTC like Term.clinicDates and the
  /// availability arrays. Compare by UTC day key, never by raw timestamp.
  clinicDate   DateTime
  role         ShiftRole
  triage       Boolean    @default(false)
  walkin       Boolean    @default(false)
  cc           Boolean    @default(false)
  remote       Boolean    @default(false)
  /// This assignment is covering the day's specialty clinic.
  ///
  /// Deliberately a plain flag and NOT a link to AttendingSpecialty: which
  /// specialty is running is a property of the DAY (ClinicDay.specialtyId), so
  /// naming it again per person would be a second copy of one fact, free to
  /// disagree with the day it belongs to. Ops asked for exactly this shape: one
  /// toggle, "not differentiated by specialty", set per assignment like the tags
  /// above rather than stored on the Person.
  ///
  /// It is also NOT a statement that someone is specialty-trained. That is a
  /// person-level credential waiting on a real training process, and it will
  /// need its own verified field when it arrives, the way PersonLanguage does.
  specialty    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  /// Restrict: term deletion is blocked while schedule history references it.
  term         Term       @relation(fields: [termId], references: [id], onDelete: Restrict)
  /// Restrict: department deletion is blocked while schedule history references it.
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// Cascade: assignments belong to the person and die with them.
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([termId, departmentId, clinicDate, personId])
  @@index([termId, clinicDate])
  @@index([personId, termId])
}

/// Swap/drop requests against the schedule. Drop when targetId/targetDate are
/// null; named swap otherwise. Approval re-validates and applies transactionally.
/// DB-LEVEL GUARDS LIVE IN RAW SQL (see migrations): a partial unique index
/// (ShiftRequest_pending_unique) prevents duplicate PENDING rows for the same
/// (requesterId, requesterDate, departmentId) triple. Guarded by
/// src/modules/schedule/services/schedule-schema-guards.test.ts. Never resolve
/// a prisma migrate diff by accepting a DROP of objects you do not recognize.
model ShiftRequest {
  id            String             @id @default(cuid())
  termId        String
  requesterId   String
  /// Clinic date of the shift being dropped or swapped away (noon-UTC anchored).
  requesterDate DateTime
  departmentId  String
  targetId      String?
  /// Populated only for swaps; may remain set even if targetId was NULLed by
  /// onDelete SetNull. The service layer must treat (targetId null AND
  /// targetDate set) as a stale/malformed swap.
  targetDate    DateTime?
  status        ShiftRequestStatus @default(PENDING)
  note          String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  term          Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  requester     Person             @relation("shiftRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target        Person?            @relation("shiftRequestTarget", fields: [targetId], references: [id], onDelete: SetNull)
  decidedBy     Person?            @relation("shiftRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  department    Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([termId, departmentId, status])
  @@index([requesterId])
}

/// Per-(department, clinic date) operational data maintained by directors
/// in the builder (currently: patients booked, for capacity math).
model ScheduleDay {
  id             String     @id @default(cuid())
  termId         String
  departmentId   String
  /// Noon-UTC anchored calendar date; compare by UTC day key.
  clinicDate     DateTime
  patientsBooked Int?
  term           Term       @relation(fields: [termId], references: [id], onDelete: Restrict)
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([termId, departmentId, clinicDate])
}

/// A department's schedule for a term, released to members. The row exists iff
/// that (term, department) schedule is currently published. Publishing gates ONLY
/// non-live terms: the live (ACTIVE) term is always visible to members with no row.
model SchedulePublication {
  id            String   @id @default(cuid())
  termId        String
  departmentId  String
  publishedAt   DateTime @default(now())
  publishedById String?

  term        Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  publishedBy Person?    @relation("schedulePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([termId, departmentId])
  @@index([termId])
}

/// Reusable configuration for one weekly Teams triage chat (Ancillary, Clinical).
/// Soft-deleted via isActive so a TriageChat created from a retired preset still
/// resolves to a name.
model TriageChatPreset {
  id              String                        @id @default(cuid())
  /// Shown on the card, e.g. "Ancillary".
  name            String
  /// Rendered into the Teams chat topic, e.g. "{{clinicDateShort}} Ancillary Triage Chat".
  nameTemplate    String
  /// Plain-text opening message with {{placeholders}}. Converted to Teams HTML at send.
  messageTemplate String
  isActive        Boolean                       @default(true)
  order           Int                           @default(0)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  departments     TriageChatPresetDepartment[]
  chats           TriageChat[]

  @@index([isActive, order])
}

/// The departments a preset draws triage-tagged directors from.
model TriageChatPresetDepartment {
  id           String           @id @default(cuid())
  presetId     String
  departmentId String
  preset       TriageChatPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([presetId, departmentId])
  @@index([departmentId])
}

/// One Teams group chat actually created. The (presetId, clinicDate) unique
/// constraint IS the idempotency guard: a double-click, a resubmitted form, or a
/// retry after a partial failure must never produce two chats for the same week.
model TriageChat {
  id              String             @id @default(cuid())
  presetId        String
  termId          String
  /// Anchored at 12:00 UTC like every other clinic date. Compare by UTC day key.
  clinicDate      DateTime
  /// The rendered chat name, as sent to Graph.
  topic           String
  /// The opening message exactly as sent, so a retry posts what the ED approved
  /// rather than a re-render of the preset template. The ED edits this text on
  /// the review screen, so the template is not a faithful record of it.
  messageBody     String
  graphChatId     String
  webUrl          String
  /// Null until the opening message actually posts. Keeping the row with a null
  /// here is what lets a retry post the message instead of creating a second chat.
  messagePostedAt DateTime?
  createdById     String?
  createdAt       DateTime           @default(now())
  /// Restrict: a preset with chat history cannot be hard-deleted (deactivate it).
  preset          TriageChatPreset   @relation(fields: [presetId], references: [id], onDelete: Restrict)
  term            Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  /// SetNull: the chat record outlives the ED who created it.
  createdBy       Person?            @relation("triageChatCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members         TriageChatMember[]

  @@unique([presetId, clinicDate])
  @@index([termId, clinicDate])
}

/// Snapshot of who was in the chat that week, and who Graph refused. Deliberately
/// a snapshot rather than a live join: it must stay true after the schedule changes.
model TriageChatMember {
  id             String     @id @default(cuid())
  triageChatId   String
  personId       String?
  /// Denormalised on purpose, so the record survives a person being deleted.
  personName     String
  departmentName String
  addedOk        Boolean
  /// Graph's error, or the reason no Entra id could be resolved.
  error          String?
  triageChat     TriageChat @relation(fields: [triageChatId], references: [id], onDelete: Cascade)
  person         Person?    @relation("triageChatMemberPerson", fields: [personId], references: [id], onDelete: SetNull)

  @@index([triageChatId])
  @@index([personId])
}

/// A language a person claims and/or has been assessed on.
///
/// Replaces the Spanish-only booleans that used to live on Person
/// (spanishSelfReported / spanishVerified / spanishVerifiedAt /
/// spanishVerifiedById). The field shape is deliberately identical to those, so
/// the interpreting department's review queue generalized without changing its
/// semantics: a row with `verifiedAt` null is awaiting human assessment, and
/// `verifiedAt` non-null means assessed, whether the answer was yes or no.
///
/// ONE source of truth. There is no Spanish special case anywhere: Spanish is
/// simply the row with language = "es".
model PersonLanguage {
  id           String    @id @default(cuid())
  personId     String
  /// Lowercase code from LANGUAGE_CODES (src/platform/languages.ts), not free
  /// text, so the same language cannot appear as "Spanish", "spanish", and
  /// "Espanol" on three different people.
  language     String
  /// Claimed by the person at intake. A claim, never a qualification.
  selfReported Boolean   @default(false)
  /// The assessment OUTCOME. Meaningless until verifiedAt is set; read the two
  /// together, never this alone.
  verified     Boolean   @default(false)
  /// Non-null once a human has assessed, yes OR no. This is what removes the
  /// person from the review queue, so a "no" settles the question rather than
  /// leaving them queued forever.
  verifiedAt   DateTime?
  /// Bare id (no FK), mirroring the spanishVerifiedById it replaces.
  verifiedById String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Cascade: the claim belongs to the person.
  person       Person    @relation("personLanguages", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, language])
  @@index([language])
}

/// A board meeting, held roughly every two weeks and attended by directors.
///
/// Term-scoped because the director roster is: attendance is recorded against
/// whoever holds an ACTIVE DIRECTOR membership in the term, resolved live rather
/// than snapshotted, matching how the schedule builder resolves its roster.
model BoardMeeting {
  id          String                   @id @default(cuid())
  termId      String
  /// Noon-UTC anchored calendar date; compare by UTC day key, never a raw
  /// timestamp. Same convention as Term.clinicDates.
  meetingDate DateTime
  title       String?
  notes       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  /// Restrict: term deletion is blocked while attendance history references it.
  term        Term                     @relation(fields: [termId], references: [id], onDelete: Restrict)
  attendance  BoardMeetingAttendance[]

  @@unique([termId, meetingDate])
  @@index([termId])
}

/// How one director was marked for one board meeting.
///
/// The absence of a row means "not yet recorded", NOT "absent": a meeting
/// nobody has taken attendance for must not silently accrue absences against
/// every director. ABSENT is only ever an explicit choice.
///
/// The director contract states that two unexcused absences equal one strike,
/// which is why EXCUSED and ABSENT are distinct values rather than a boolean.
/// Reaching that threshold surfaces the count to a human; it does not create a
/// strike automatically, matching the strike-limit decision in the incidents
/// module.
model BoardMeetingAttendance {
  id           String                @id @default(cuid())
  meetingId    String
  personId     String
  status       BoardAttendanceStatus
  note         String?
  recordedById String?
  recordedAt   DateTime              @default(now())
  /// Cascade: the record belongs to the meeting.
  meeting      BoardMeeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// Cascade: the record is meaningless without the person.
  person       Person                @relation("boardAttendancePerson", fields: [personId], references: [id], onDelete: Cascade)
  /// Restrict: who recorded it is part of the record.
  recordedBy   Person?               @relation("boardAttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([meetingId, personId])
  @@index([personId])
}

enum BoardAttendanceStatus {
  PRESENT
  EXCUSED
  ABSENT
}

/// A clinical specialty an attending practises in.
///
/// Doubles as the roster's grouping (Primary Care, Reproductive Health,
/// Behavioral Health) and, for those flagged `runsSpecialtyClinic`, as the
/// rotating clinic named in the schedule's Specialty Clinic column (Dermatology,
/// Neurology, Nephrology). Kept as data rather than an enum because the roster
/// gains specialties as the clinic adds services.
model AttendingSpecialty {
  id                  String                @id @default(cuid())
  /// Short code used in the schedule grid and imports, e.g. "RHD".
  code                String                @unique
  /// What people read, e.g. "Reproductive Health".
  name                String                @unique
  /// Whether this specialty can be named as the day's rotating Specialty Clinic.
  runsSpecialtyClinic Boolean               @default(false)
  order               Int
  attendings          Attending[]
  capabilities        AttendingCapability[]
  clinicDays          ClinicDay[]

  @@index([order])
}

/// One qualification asked about attendings, e.g. "IUD In" or "Can sign GAC".
///
/// `specialtyId` scopes the question: set, only attendings in that specialty are
/// asked (the six reproductive-health procedures); null, everyone is (signing
/// GAC spans primary care and reproductive health, per the term sheets).
///
/// This replaced six columns hardcoded onto every attending, which meant a
/// primary care attending carried six reproductive-health fields and no other
/// question could be asked without a migration.
///
/// `key` is the stable machine name. The reproductive-health readiness engine
/// reads its six BY KEY, so renaming one silently blanks that column of the
/// panel; the label is free to change.
model AttendingCapability {
  id          String                     @id @default(cuid())
  /// Stable machine name, e.g. "iudIn".
  key         String                     @unique
  /// What the form and roster table show, e.g. "IUD In".
  label       String
  /// Display order in the matrix.
  order       Int
  /// Null means every attending is asked.
  specialtyId String?
  specialty   AttendingSpecialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  values      AttendingCapabilityValue[]

  @@index([specialtyId])
}

/// One attending's answer to one capability question.
///
/// A MISSING row means "unknown", so adding a capability does not require
/// backfilling every attending, and readers must treat absence and "unknown"
/// identically rather than as a gap.
model AttendingCapabilityValue {
  id           String              @id @default(cuid())
  attendingId  String
  capabilityId String
  /// "yes" | "no" | "unknown" (legacy semantics, kept so the ported readiness
  /// engine and the imports need no value translation).
  value        String              @default("unknown")
  attending    Attending           @relation(fields: [attendingId], references: [id], onDelete: Cascade)
  capability   AttendingCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([attendingId, capabilityId])
  @@index([attendingId])
  @@index([capabilityId])
}

/// An attending physician on the clinic's roster.
///
/// ONE central roster, maintained by Faculty Relations (the
/// schedule.manage_attendings permission), not a per-department list. An
/// attending is not a member of a service line; they have a SPECIALTY and cover
/// whichever slots the schedule puts them in, and many cover more than one area
/// across a term.
///
/// `scheduleName` is how the schedule and the reminder email name them ("Peggy
/// Bia"); `fullName` is the roster's formal form ("Bia, Margaret"). They differ
/// often enough that importing the term sheets depends on the distinction.
model Attending {
  id               String                     @id @default(cuid())
  /// How the schedule grid names them. Unique so a schedule cell resolves.
  scheduleName     String                     @unique
  fullName         String
  /// Post-nominals as written on the contact sheet, e.g. "MD, MPH". Free text:
  /// the real values include MD, DO, PA-C, APRN, PsyD, MBBS and combinations.
  credentials      String?
  specialtyId      String?
  email            String?
  phone            String?
  notes            String?
  isActive         Boolean                    @default(true)
  /// The Hub account this attending signs in with, when they have one.
  ///
  /// Nullable and NOT the identity of the attending: the roster is the source of
  /// truth for who covers clinic, and it predates Hub access by years. A Person
  /// is created only to give them a login (see enableHubAccess), so an attending
  /// with no email, or one who has never been granted access, simply has none.
  ///
  /// SetNull, not Cascade: deleting the Hub account must revoke the login, never
  /// remove a doctor from the schedule.
  personId         String?                    @unique
  person           Person?                    @relation("attendingAccount", fields: [personId], references: [id], onDelete: SetNull)
  specialty        AttendingSpecialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  capabilities     AttendingCapabilityValue[]
  clinicDays       ClinicDayAttending[]
  /// Clinic dates where they hold the on-call week (see ClinicDay.onCallAttending).
  onCallDays       ClinicDay[]                @relation("clinicDayOnCall")
  credentialing    AttendingCredentialing?
  availability     AttendingAvailability[]
  requests         AttendingShiftRequest[]    @relation("attendingRequestRequester")
  requestsAsTarget AttendingShiftRequest[]    @relation("attendingRequestTarget")

  @@index([specialtyId])
  @@index([isActive])
}

/// One attending's self-reported availability for one term: the clinic dates
/// they say they can cover.
///
/// ONE tier, unlike the volunteer side. TermMembership carries three
/// (baseline / self / director override) because a volunteer's availability
/// arrives from their application, gets self-updated, and can be pinned by a
/// director. An attending's arrives exactly one way -- they tell Faculty
/// Relations -- so a second tier would be a column nothing ever writes.
///
/// Advisory, not a constraint: Faculty Relations still books the grid by hand
/// and may staff someone on a date they did not tick (they are asked, and they
/// agree). This is what the builder shows while staffing, not a gate on it.
///
/// The row's absence and an empty `dates` array mean different things: absent is
/// "never told us", empty is "told us they can cover nothing this term".
model AttendingAvailability {
  id          String     @id @default(cuid())
  attendingId String
  termId      String
  /// Noon-UTC anchored clinic dates, like Term.clinicDates. Compare by UTC day key.
  dates       DateTime[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  attending   Attending  @relation(fields: [attendingId], references: [id], onDelete: Cascade)
  term        Term       @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([attendingId, termId])
  @@index([termId])
}

/// Swap/drop requests against the ATTENDING schedule. Drop when the target
/// fields are null; named swap otherwise.
///
/// A sibling of ShiftRequest rather than a widening of it, because the two name
/// different things. A volunteer shift is (person, date, department) and moves
/// as a whole; an attending assignment is (attending, clinic day, SLOT), and a
/// swap has to say which COLUMN moves -- an attending covering both the 9am-12pm
/// and the RHD column on one Saturday is giving up one of them, not the day.
/// Bolting a nullable slotId onto ShiftRequest would have made every existing
/// volunteer code path carry a column it can never have.
///
/// Approval is Faculty Relations' (schedule.manage_attendings), not a
/// department director's: attendings belong to no department, so the
/// department-scoped approver routing on ShiftRequest has nothing to resolve.
///
/// DB-LEVEL GUARD LIVES IN RAW SQL (see migrations): a partial unique index
/// (AttendingShiftRequest_pending_unique) prevents duplicate PENDING rows for
/// the same (requesterId, requesterDayId, requesterSlotId) triple, mirroring
/// ShiftRequest_pending_unique. Guarded by
/// src/modules/schedule/services/schedule-schema-guards.test.ts. Never resolve a
/// prisma migrate diff by accepting a DROP of objects you do not recognize.
model AttendingShiftRequest {
  id              String             @id @default(cuid())
  termId          String
  requesterId     String
  /// The clinic day and column being given up.
  requesterDayId  String
  requesterSlotId String
  /// Populated only for swaps. All three move together; the service layer must
  /// treat a partially-null trio as a stale/malformed swap, the same way
  /// ShiftRequest treats (targetId null AND targetDate set).
  targetId        String?
  targetDayId     String?
  targetSlotId    String?
  status          ShiftRequestStatus @default(PENDING)
  note            String?
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  term            Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  requester       Attending          @relation("attendingRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterDay    ClinicDay          @relation("attendingRequestRequesterDay", fields: [requesterDayId], references: [id], onDelete: Cascade)
  requesterSlot   ClinicSlot         @relation("attendingRequestRequesterSlot", fields: [requesterSlotId], references: [id], onDelete: Cascade)
  target          Attending?         @relation("attendingRequestTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetDay       ClinicDay?         @relation("attendingRequestTargetDay", fields: [targetDayId], references: [id], onDelete: SetNull)
  targetSlot      ClinicSlot?        @relation("attendingRequestTargetSlot", fields: [targetSlotId], references: [id], onDelete: SetNull)
  decidedBy       Person?            @relation("attendingRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([termId, status])
  @@index([requesterId])
  @@index([targetId])
}

/// A named column of the attending schedule: a window of the clinic day that is
/// staffed separately, e.g. "9am-12pm", "RHD Attending", "BHD Clinic".
///
/// CLINIC-WIDE, not per department. The schedule is one grid covering the whole
/// Saturday; reproductive health and behavioral health are columns in it, not
/// separate schedules. Editable by Faculty Relations, because the columns drift
/// between terms.
///
/// Times are "HH:MM" in the display time zone. They are labels for humans, not
/// scheduling arithmetic: volunteer shifts remain date-only (ShiftAssignment),
/// so nothing joins a volunteer to a slot.
model ClinicSlot {
  id             String                  @id @default(cuid())
  /// What the grid column shows, e.g. "9am-12pm".
  label          String                  @unique
  startTime      String
  endTime        String
  /// Column order, left to right.
  order          Int
  /// Whether more than one attending may cover this slot on one date. The
  /// 9am-12pm column really does carry two, which is why the schedule sheet
  /// repeats that header twice.
  allowsMultiple Boolean                 @default(false)
  /// The department whose members this column's attending covers, e.g. the
  /// "RHD Attending" column covers SRHD. Null means the column belongs to no
  /// department (Specialty Clinic, Shadowing) and is shown to nobody's shift.
  ///
  /// Many columns may point at ONE department -- primary care is staffed by both
  /// the 9am-12pm and 11am-2pm columns, and a PCAR volunteer is covered by both.
  ///
  /// Departments the column does NOT name still resolve through it by one-hop
  /// DepartmentDelegation: SCTP and JCTP are managed by PCAR, so they read the
  /// PCAR columns without each having to be named here. That keeps this mapping
  /// at the handful of clinical parents rather than one row per department.
  departmentId   String?
  department     Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments    ClinicDayAttending[]
  requestsFrom   AttendingShiftRequest[] @relation("attendingRequestRequesterSlot")
  requestsTo     AttendingShiftRequest[] @relation("attendingRequestTargetSlot")

  @@index([order])
  @@index([departmentId])
}

/// One attending covering one slot of one clinic day.
///
/// Unique on (day, slot, attending) rather than (day, slot): a slot may carry
/// several attendings, and the only thing forbidden is naming the same person
/// twice in one slot.
///
/// A MISSING row means that slot is unstaffed. Deactivating an attending does
/// NOT remove the row, so the grid can still show the stale assignment and a
/// manager can see the gap; only a hard delete cascades.
model ClinicDayAttending {
  id          String     @id @default(cuid())
  clinicDayId String
  slotId      String
  attendingId String
  /// Order within the slot, so two attendings in one column read consistently.
  order       Int        @default(0)
  clinicDay   ClinicDay  @relation(fields: [clinicDayId], references: [id], onDelete: Cascade)
  slot        ClinicSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  attending   Attending  @relation(fields: [attendingId], references: [id], onDelete: Cascade)

  @@unique([clinicDayId, slotId, attendingId])
  @@index([clinicDayId])
  @@index([slotId])
  @@index([attendingId])
}

/// One clinic date's attending coverage, clinic-wide.
///
/// Unique on (term, date): there is ONE schedule for the Saturday, with a column
/// per slot, which is how Faculty Relations actually keeps it. Per-service-line
/// clinic rows were a mis-modelling of that single grid.
model ClinicDay {
  id                String                  @id @default(cuid())
  termId            String
  /// Noon-UTC anchored calendar date; compare by UTC day key.
  clinicDate        DateTime
  /// The clinic does not run this Saturday (holidays, breaks). Kept as a flag
  /// rather than removing the date, because the term calendar still has it and
  /// the schedule shows it as closed rather than as an unstaffed gap.
  isClosed          Boolean                 @default(false)
  /// Why, when closed, e.g. "HAVEN FREE CLINIC CLOSED".
  closedNote        String?
  /// Holds the on-call pager for the week LEADING UP TO THE NEXT clinic day, not
  /// for this one. Stored on the date its row sits on because that is how the
  /// schedule is read and sent, but the coverage window runs forward.
  onCallAttendingId String?
  /// The rotating specialty clinic running this date, if any (Derm, Neuro,
  /// Nephro). Separate from the attending covering it, since the sheet often
  /// names the clinic before the doctor is settled.
  specialtyId       String?
  /// Reproductive health director on point for the day.
  directorName      String?
  /// Procedures booked for the day, for the readiness cap warning.
  proceduresBooked  Int?
  term              Term                    @relation(fields: [termId], references: [id], onDelete: Restrict)
  onCallAttending   Attending?              @relation("clinicDayOnCall", fields: [onCallAttendingId], references: [id], onDelete: SetNull)
  specialty         AttendingSpecialty?     @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  attendings        ClinicDayAttending[]
  requestsFrom      AttendingShiftRequest[] @relation("attendingRequestRequesterDay")
  requestsTo        AttendingShiftRequest[] @relation("attendingRequestTargetDay")

  @@unique([termId, clinicDate])
  @@index([onCallAttendingId])
  @@index([specialtyId])
}

/// Faculty Relations' onboarding pipeline for one attending.
///
/// Mirrors the credentialing tracker the FCRL director keeps by hand. The stages
/// are deliberately independent booleans rather than one status enum: they are
/// chased in parallel and completed out of order, and a single status could not
/// say "forms in, NPDB clear, still waiting on the steering committee".
model AttendingCredentialing {
  id                              String    @id @default(cuid())
  attendingId                     String    @unique
  /// 1) info email sent to the interested attending.
  infoEmailSent                   Boolean   @default(false)
  /// 2) credentialing forms received back.
  formsReceived                   Boolean   @default(false)
  /// 3) NPDB check requested, and OAPD (faculty affairs) cleared.
  npdbCheck                       Boolean   @default(false)
  oapd                            Boolean   @default(false)
  /// 2b) FTCA coverage, when the attending needs it.
  needsFtca                       Boolean   @default(false)
  ftcaSubmitted                   Boolean   @default(false)
  /// 4) Yale-affiliated attendings go to the medical directors.
  medDirectorApprovalNeeded       Boolean   @default(false)
  medDirectorApproved             Boolean   @default(false)
  /// 5) community providers go to the steering committee instead.
  steeringCommitteeApprovalNeeded Boolean   @default(false)
  steeringCommitteeApproved       Boolean   @default(false)
  /// 6) cleared to be handed to the clinical advisors.
  approved                        Boolean   @default(false)
  notes                           String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  attending                       Attending @relation(fields: [attendingId], references: [id], onDelete: Cascade)
}

/// How an attendance record came to exist. SELF_GEO passed the geofence;
/// SELF_REMOTE is a telehealth volunteer for whom the fence does not apply;
/// STAFF was recorded by a director when self check-in was not possible.
enum CheckInMethod {
  SELF_GEO
  SELF_REMOTE
  STAFF
}

/// One row per person per clinic day. Its existence IS the attendance fact;
/// absence is derived (an assignment with no row, on a past clinic date), never
/// stored. Keyed per person rather than per assignment because a person may hold
/// assignments in two departments on one clinic date and still arrives once.
model ClinicAttendance {
  id             String        @id @default(cuid())
  termId         String
  /// Noon-UTC anchored calendar date, matching Term.clinicDates and
  /// ShiftAssignment.clinicDate. Compare by UTC day key, never raw timestamp.
  clinicDate     DateTime
  personId       String
  /// True arrival instant, NOT date-anchored. Kept so punctuality and hours can
  /// be derived later over data collected from day one.
  checkedInAt    DateTime      @default(now())
  method         CheckInMethod
  /// Rounded metres from the configured fence centre. Null for SELF_REMOTE and
  /// STAFF. Raw coordinates are deliberately never persisted (privacy).
  distanceMeters Int?
  /// The fix's reported accuracy in metres, kept for tuning the thresholds.
  accuracyMeters Int?
  /// The staff member who recorded it. Null for self check-in.
  recordedById   String?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// Restrict: term deletion is blocked while attendance history references it.
  term       Term    @relation(fields: [termId], references: [id], onDelete: Restrict)
  /// Cascade: attendance belongs to the person and dies with them.
  person     Person  @relation("clinicAttendancePerson", fields: [personId], references: [id], onDelete: Cascade)
  /// SetNull: the record survives the recorder being deleted.
  recordedBy Person? @relation("clinicAttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([termId, clinicDate, personId])
  @@index([termId, clinicDate])
  @@index([personId, termId])
}

model RecruitmentCycle {
